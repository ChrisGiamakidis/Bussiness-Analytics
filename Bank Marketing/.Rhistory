knitr::opts_chunk$set(echo = TRUE)
bank_data <- read.csv("bank.csv", sep = ";", header = TRUE)
stats <- data.frame(
Variable = c("Age", "Job", "Marital", "Education", "Default", "Balance", "Housing", "Loan"),
Description = c(
"Ηλικία", "Επάγγελμα", "Οικογενειακή κατάσταση", "Εκπαίδευση", "Πιστωτικό υπόλοιπο δανείων σε καθυστέρηση", "Μέσο ετήσιο υπόλοιπο", "Στεγαστικό δάνειο", "Προσωπικό δάνειο"),
Type = c("Αριθμητική", "Κατηγορική", "Κατηγορική", "Κατηγορική", "Κατηγορική", "Αριθμητική", "Κατηγορική", "Κατηγορική"),
Range = c(
paste(range(bank_data$age), collapse = " - "),
paste(levels(factor(bank_data$job)), collapse = ", "),
paste(levels(factor(bank_data$marital)), collapse = ", "),
paste(levels(factor(bank_data$education)), collapse = ", "),
paste(levels(factor(bank_data$default)), collapse = ", "),
paste(range(bank_data$balance), collapse = " - "),
paste(levels(factor(bank_data$housing)), collapse = ", "),
paste(levels(factor(bank_data$loan)), collapse = ", ")
),
Measurement_Unit = c("Έτη", "-", "-", "-", "-", "Ευρώ (€)", "-", "-")
)
View(stats)
rm(stats)
bank_data$y <- ifelse(bank_data$y == "yes", 1, 0)
knitr::opts_chunk$set(echo = TRUE)
bank_data$y <- ifelse(bank_data$y == 1, "yes", "no")
bank_data$y <- ifelse(bank_data$y == "yes", 1, 0)
NBA_train <- read.csv("NBA_train.csv")
NBA_train <- read.csv("NBA_train.csv")
