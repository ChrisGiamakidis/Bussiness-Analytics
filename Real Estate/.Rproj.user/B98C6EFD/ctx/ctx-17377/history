library(caTools)
set.seed(18)
split <- sample.split(framingham$TenYearCHD, SplitRatio=0.65)
train = subset(framingham,split==TRUE)
test = subset(framingham,split==FALSE)
nrow(train)
nrow(train)
nrow(test)
framinghamLog <- glm(TenYearCHD ~ ., data = train, family=binomial)
summary(framinghamLog)
predictTest <- predict(framinghamLog, type="response", newdata=test)
summary(predictTest)
table(test$TenYearCHD, predictTest > 0.5)
table(test$TenYearCHD, predictTest > 0.6)
table(test$TenYearCHD, predictTest > 0.3)
table(test$TenYearCHD, predictTest > 0.5)
table(test$TenYearCHD, predictTest > 0.5)
library(ROCR)
ROCRpred <- prediction(predictTest, test$TenYearCHD)
train2 = na.omit(train)
test2 = na.omit(test)
framinghamLog2 = glm(TenYearCHD ~ ., data = train2, family = binomial)
predictTest2 = predict(framinghamLog2, type = "response", newdata = test2)
ROCRpred2 <- prediction(predictTest2, test2$TenYearCHD)
ROCRperf2 <- performance(ROCRpred2, `tpr`, `fpr`)
ROCRperf2 <- performance(ROCRpred2, 'tpr', 'fpr')
