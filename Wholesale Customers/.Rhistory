tapply(movielens$Romance, clusterGroups, mean)
colMeans(subset(movielens[2:20], clusterGroups == 1))
colMeans(subset(movielens[2:20], clusterGroups == 2))
colMeans(subset(movielens[2:20], clusterGroups == 3))
subset(movielens, Title == "Men in Black (1997)")
clusterGroups[257]
