NBA_train <- read.csv("NBA_train.csv")
NBA_train$PTSdiff <- NBA_train$PTS - NBA_train$oppPTS
plot(NBA_train$W, NBA_train$PTSdiff)
plot(NBA_train$PTSdiff, NBA_train$W)
cor(NBA_train$PTSdiff, NBA_train$W)
WinsReg <- lm(W~PTSdiff, data=NBA_train)
summary(WinsReg)
coef(NBA_train$PTSdiff)
coef(NBA_train)
coef(WinsReg)
PointsReg <- lm(PTS ~ `2PA`+ `3PA` + FTA + AST + ORB + DRB + TOV + STL + BLK,
data=NBA_train)
PointsReg <- lm(PTS ~ X2PA+ X3PA + FTA + AST + ORB + DRB + TOV + STL + BLK,
data=NBA_train)
View(PointsReg)
PointsReg <- lm(PTS ~ `2PA`+ `3PA` + FTA + AST + ORB + DRB + TOV + STL + BLK,
data=NBA_train)
PointsReg <- lm(PTS ~ X2PA + X3PA + FTA + AST + ORB + DRB + TOV + STL + BLK, data=NBA_train)
summary(PointsReg)
SSE <- sum(PointsReg$residuals^2)
RMSE <- sqrt(SSE/nrow(NBA_train))
SSE
RMSE
mean(NBA_train$PTS)
