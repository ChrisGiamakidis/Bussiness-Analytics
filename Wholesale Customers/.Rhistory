library(readr)
movielens <- read_delim("https://files.grouplens.org/datasets/movielens/ml-100k/u.item",
delim = "|", escape_double = FALSE, col_names = FALSE,
col_types = cols(X3 = col_datetime(format = "%d-%b-%Y")),
trim_ws = TRUE)
View(movielens)
colnames(movielens) = c("ID", "Title", "ReleaseDate", "VideoReleaseDate", "IMDB", "Unknown", "Action", "Adventure", "Animation", "Childrens", "Comedy", "Crime", "Documentary", "Drama", "Fantasy", "FilmNoir", "Horror", "Musical", "Mystery", "Romance", "SciFi", "Thriller", "War", "Western")
movielens$ID = NULL
movielens$ReleaseDate = NULL
movielens$VideoReleaseDate = NULL
movielens$IMDB = NULL
movielens = unique(movielens)
distances = dist(movielens[2:20], method = "euclidean")
clusterMovies = hclust(distances, method = "ward.D2")
plot(clusterMovies)
clusterGroups = cutree(clusterMovies, k=10)
plot(clusterGroups)
tapply(movielens$Action, clusterGroups, mean)
tapply(movielens$Romance, clusterGroups, mean)
plot(clusterMovies)
colMeans(subset(movielens[2:20], clusterGroups == 1))
colMeans(subset(movielens[2:20], clusterGroups == 2))
colMeans(subset(movielens[2:20], clusterGroups == 3))
subset(movielens, Title == "Men in Black (1997)")
View(movielens)
View(movielens)
clusterGroups[257]
cluster2 = subset(movielens, clusterGroups == 2)
cluster2$Title[1:10]
View(cluster2)
View(movielens)
View(movielens)
View(movielens)
View(movielens)
plot(clusterMovies)
data("USArrests")
force(USArrests)
View(USArrests)
View(USArrests)
