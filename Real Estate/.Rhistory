PointsReg2 <- lm(PTS ~ X2PA + X3PA + FTA + AST + ORB + DRB + STL + BLK,
data=NBA_train)
summary(PointsReg2)
SSE2 <- sum(PointsReg2$residuals^2)
SSE2
