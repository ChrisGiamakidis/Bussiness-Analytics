library(readr)
realEstate <- read.csv("Real estate.csv")
realEstate <- subset(realEstate, select = -No)
names(realEstate)[names(realEstate) == "X1.transaction.date"] <- "TransactionDate"
names(realEstate)[names(realEstate) == "X2.house.age"] <- "HouseAge"
names(realEstate)[names(realEstate) == "X3.distance.to.the.nearest.MRT.station"] <- "MRTdistance"
names(realEstate)[names(realEstate) == "X4.number.of.convenience.stores"] <- "NoConvinienceStores"
names(realEstate)[names(realEstate) == "X5.latitude"] <- "Latitude"
names(realEstate)[names(realEstate) == "X6.longitude"] <- "Longitude"
names(realEstate)[names(realEstate) == "Y.house.price.of.unit.area"] <- "SQMprice"
rm(realEstate)
